FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig*.json ./
COPY src ./src
COPY scripts ./scripts
COPY web ./web
COPY prototypes/la-cite/gift-preparation.js prototypes/la-cite/gift-preparation.js
COPY prototypes/la-cite/style.css prototypes/la-cite/style.css
RUN npm run build:web
ENV NODE_ENV=production
USER node
CMD ["node", "scripts/serve-staging.mjs"]
